generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://neondb_owner:npg_FtVnX8Kfg6CZ@ep-falling-frost-atjxjuzh.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require")
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String       @unique
  password    String
  tier        String       @default("free")
  createdAt   DateTime     @default(now())
  extractions Extraction[]
  usageLogs   UsageLog[]
}

model Extraction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  inputText  String
  schemaName String
  schemaDef  String
  result     String
  tokensUsed Int
  latencyMs  Float
  createdAt  DateTime @default(now())
}

model UsageLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokens     Int
  latencyMs  Float
  schemaName String
  createdAt  DateTime @default(now())
}
